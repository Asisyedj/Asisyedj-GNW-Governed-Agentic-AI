# Perplexity WebUI Scraper — Local OpenAI-compatible API setup
# Get your session token from browser (see README_SETUP.md step 2)
PERPLEXITY_SESSION_TOKEN=__Secure-next-auth.session-token_value_copy_from_browser

# Optional: gateway key so others can't use your server without this key
PERPLEXITY_API_KEY=change-me-to-a-strong-random-string

# Server bind address & port
PPLX_API_HOST=127.0.0.1
PPLX_API_PORT=8000
