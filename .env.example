# GNW Deep Research provider (defaults to LLM_* when omitted)
GNW_DEEP_RESEARCH_BASE_URL=https://api.openai.com/v1
GNW_DEEP_RESEARCH_API_KEY=
GNW_DEEP_RESEARCH_MODEL=o3-deep-research
GNW_DEEP_RESEARCH_MAX_TOOL_CALLS=50
GNW_DEEP_RESEARCH_TIMEOUT_MS=3600000
GNW_DEEP_RESEARCH_USE_CODE_INTERPRETER=true

# Optional domain restriction. Empty means no additional GNW domain allowlist.
GNW_DEEP_RESEARCH_ALLOWED_DOMAINS=

# Optional specialized read-only MCP server.
GNW_DEEP_RESEARCH_MCP_URL=
GNW_DEEP_RESEARCH_MCP_LABEL=

# The provider host must also be permitted by the GNW egress policy.
# Example: GNW_ALLOWED_EGRESS_HOSTS=api.openai.com
