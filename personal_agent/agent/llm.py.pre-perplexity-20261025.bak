"""Original Gemini/Antigravity wrapper preserved for audit reference only."""
import os
import json
try:
    from antigravity_sdk import GeminiClient  # type: ignore
except ImportError:
    class GeminiClient:
        def __init__(self, model: str = "gemini-3.8-flash"):
            self.model = model
        def chat(self, messages: list[dict]):
            content = " ".join(msg.get("content", "") for msg in messages if msg.get("role") == "user")
            return {"content": content}
class LLMWrapper:
    def __init__(self, model_name: str = "gemini-3.8-flash"):
        self.client = GeminiClient(model=model_name)
        self.model_name = model_name
    def call(self, messages: list[dict], stream: bool = False):
        response = self.client.chat(messages)
        return response.get("content", "")
_llm = LLMWrapper()
def call_llm(messages: list[dict]) -> str:
    return _llm.call(messages)
