# syntax=docker/dockerfile:1
# Node.js 22.23.4 LTS on Alpine 3.23; immutable multi-arch manifest digest.
ARG NODE_IMAGE=node:22.23.4-alpine3.23@sha256:6abbcf5dd6b231da109bcde1181db1d92bf78015ae1a9514d9807c1f857869db

FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache python3 make g++ \
 && musl_ver="$(apk info -v musl | sed -n 's/^musl-//p')" \
 && test -n "$musl_ver" \
 && test "$(apk version -t "$musl_ver" "1.2.5-r24")" != "<"
COPY package.json package-lock.json* ./
RUN npm ci
COPY tsconfig.json vite.config.ts vitest.config.ts ./
COPY src ./src
RUN npm run typecheck && npx esbuild src/executor/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/executor/index.js

FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production EXECUTOR_PORT=8790 EXECUTOR_ARTIFACT_DIR=/data/artifacts EXECUTOR_GRANT_ISSUER= EXECUTOR_GRANT_PUBLIC_KEY_PEM= NODE_OPTIONS=--disable-proto=throw
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache libstdc++ \
 && musl_ver="$(apk info -v musl | sed -n 's/^musl-//p')" \
 && test -n "$musl_ver" \
 && test "$(apk version -t "$musl_ver" "1.2.5-r24")" != "<" \
 && addgroup -S -g 10001 gnw \
 && adduser -S -D -H -u 10001 -G gnw gnw \
 && mkdir -p /data/artifacts && chown -R gnw:gnw /data
COPY --from=build --chown=gnw:gnw /app/node_modules ./node_modules
COPY --from=build --chown=gnw:gnw /app/dist/executor ./dist/executor
COPY --chown=gnw:gnw package.json ./
USER gnw
EXPOSE 8790
HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=5 CMD node -e "fetch('http://127.0.0.1:'+(process.env.EXECUTOR_PORT||8790)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","dist/executor/index.js"]
